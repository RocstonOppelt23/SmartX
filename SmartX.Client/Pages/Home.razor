@page "/"

<PageTitle>Smart-X</PageTitle>

<div class="home-shell">
    <header class="home-header">
        <h1>Smart-X IoT Mesh Ecosystem</h1>
        <p class="muted">Industrial IoT dashboard for ESP32 sensor mesh networks.</p>
    </header>

    <main class="home-grid">
        <a class="home-card card-cta" href="/ingestion">
            <div class="card-title">Sensor Data Ingestion</div>
            <div class="card-body">Register nodes, upload files, monitor live telemetry.</div>
        </a>

        <a class="home-card card-cta" href="/command-stream">
            <div class="card-title">Real-Time Command Stream</div>
            <div class="card-body">Live telemetry queues, manual overrides with undo, and predictive suggested actions.</div>
        </a>

        <div class="home-card card-coming">
            <div class="card-title">Network Topology</div>
            <div class="card-body muted">Coming in the final PoE.</div>
        </div>
    </main>

    <style>
        /* Layout and background remain unchanged; enforce high-contrast text colors explicitly */
        .home-shell { padding: 2rem; background: linear-gradient(180deg,#071024,#04101a); color: #e5e7eb; min-height: 60vh; }
        .home-header { text-align: center; }

        /* Headings: pure white */
        h1, h2, h3 { color: #ffffff; }

        /* Labels: light grey */
        label { color: #d1d5db; }

        /* Body and paragraph text: near-white */
        p, .card-body, .muted { color: #e5e7eb; }

        /* Inputs and selects: input text should be white; placeholder lighter grey */
        input, textarea, select, .form-control, .control { color: #ffffff; }
        input::placeholder, textarea::placeholder, .control::placeholder { color: #9ca3af; opacity: 1; }

        .home-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; max-width: 960px; margin: 2rem auto 0; }
        .home-card { background: #0f1724; padding: 1.25rem; border-radius: 12px; color: inherit; text-decoration: none; box-shadow: 0 8px 24px rgba(2,6,23,0.6); }
        .card-cta { border: 1px solid rgba(6,182,212,0.12); display: flex; flex-direction: column; justify-content: center; }
        .card-title { font-weight: 700; font-size: 1.1rem; margin-bottom: 0.4rem; }
        .card-cta:hover { transform: translateY(-4px); box-shadow: 0 14px 40px rgba(6,182,212,0.06); }

        @@media (max-width: 860px) { .home-grid { grid-template-columns: 1fr; } }
    </style>

</div>
